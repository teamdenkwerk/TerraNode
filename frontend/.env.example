# VITE_API_BASE_URL: Base URL of the Geo-Reconciliation FastAPI backend
# (github.com/ShubhAgarwal-03/Geo-Reconciliation).
# Defaults to http://localhost:8000 if unset (what `uvicorn backend.main:app --reload` binds to).
# For Vercel production, set this to your deployed backend URL, e.g.:
# VITE_API_BASE_URL=https://your-backend.railway.app
VITE_API_BASE_URL=http://localhost:8000
